# ==============================================================================
# Xboard-RS Configuration File
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=7001
APP_NAME=Xboard
APP_KEY=base64:xboard_default_key_change_me_32bytes!
APP_URL=http://127.0.0.1:7001
APP_DEBUG=false
RUST_LOG=xboard_rs=info,tower_http=info

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# 1. SQLite Mode (Default, lightweight & self-contained)
DB_CONNECTION=sqlite
DB_DATABASE=xboard.db

# 2. MySQL Mode (Enterprise & high concurrency, uncomment to use)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=xboard
# DB_USERNAME=root
# DB_PASSWORD=

# ------------------------------------------------------------------------------
# Cache Settings
# ------------------------------------------------------------------------------
# Default: In-Memory concurrency cache (no external Redis required)
# Optional Redis for distributed multi-instance deployment:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=